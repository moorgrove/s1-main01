{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "flux": {
    "fileMatch": ["kubernetes/.+\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["kubernetes/.+\\.yaml$"]
  },
  "kustomize": {
    "fileMatch": ["kubernetes/.+\\.yaml$"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["quay.io/ceph/ceph"],
      "allowedVersions": "<21.0.0"
    },
    {
      "matchPackageNames": ["ttlequals0/minuspod"],
      "sourceUrl": "https://github.com/ttlequals0/minuspod"
    },
    {
      "description": "Automerge renovate updates",
      "matchPackagePatterns": ["renovate"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["kubernetes/.+\\.yaml$"],
      "matchStrings": [
        "image:\\s*[\"']?(?<depName>[^:\\s\"']+):(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}