# Talos - generated configuration files
talos/clusterconfig/*controlplane*
talos/clusterconfig/*worker*
talos/clusterconfig/*talosconfig*

# Talos - unencrypted secrets
talos/*secret*

# SOPS/Age - keys
*.key
*.agekey

# Allow Kubernetes - encrypted files (e.g. SOPS) that should be committed
!kubernetes/**/*.enc.yaml

# Helm - local chart files generated during debugging
kubernetes/**/*.tgz
charts/

# General safety net - decrypted files (e.g. VSCode + SOPS plugin)
.decrypted*

# Backup folder
backup/*

# Temporary files
*.tmp

# Database files
*.db

# OS specific
.DS_Store
Thumbs.db

# Editor specific
.vscode/settings.json
*.swp
*.swo